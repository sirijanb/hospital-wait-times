    private static readonly string[] Provinces =
    {
        "ON", "BC", "QC", "AB", "MB", "SK",
        "NS", "NB", "NL", "PE", "NT", "YT", "NU"
    };
    @* Dictionary<string, int> HospitalsByProvince = new(); *@
    List<(string Province, int Count)> HospitalsByProvince = new();


    string? ExtractProvince(string address)
    {
        foreach (var p in Provinces)
        {
            if (address.Contains($" {p} ", StringComparison.OrdinalIgnoreCase) ||
                address.EndsWith($" {p}", StringComparison.OrdinalIgnoreCase))
            {
                return p;
            }
        }
        return null;
    }

    private async Task GroupHospitalsbyProvince()
    {
        var addresses = await HospitalService.GetHospitalsAddressAsync();
        HospitalsByProvince = addresses
                                .Select(a => ExtractProvince(a))
                                .Where(a => !string.IsNullOrWhiteSpace(a))
                                .GroupBy(a => a!)
                                .OrderByDescending(a => a.Count())
                                .Select(a => (Province: a.Key, Count: a.Count()))
                                .ToList();
    }
}